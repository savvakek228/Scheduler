[
  {
    "id": "scheduler-gitops",
    "execute-command": "/opt/scheduler/deploy/gitops-deploy.sh",
    "command-working-directory": "/opt/scheduler",
    "response-message": "Scheduler GitOps deploy started",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "replace-with-secret-from-/etc/scheduler/gitops-webhook.secret",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/master",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        }
      ]
    }
  }
]
