    // ---------------- взаимодействие ----------------

    private void SelectStep(int index)
    {
        _autoPlaying = false;
        _selectedStep = _selectedStep == index ? null : index;
    }

    private void SelectState(int index) =>
        _selectedState = _selectedState == index ? null : index;

    private void SelectProject(int index) =>
        _selectedProject = _selectedProject == index ? null : index;

    private void ResetMap()
    {
        _autoPlaying = false;
        _selectedStep = null;
    }

    private void PrevStep()
    {
        _autoPlaying = false;
        _selectedStep = _selectedStep is > 0 ? _selectedStep - 1 : null;
    }

    private void NextStep() =>
        _selectedStep = Math.Min((_selectedStep ?? -1) + 1, Steps.Length - 1);

    private async Task ToggleAutoAsync()
    {
        if (_autoPlaying)
        {
            _autoPlaying = false;
            return;
        }

        _autoPlaying = true;
        if (_selectedStep is null)
            _selectedStep = -1;

        try
        {
            while (_autoPlaying && _selectedStep < Steps.Length - 1)
            {
                _selectedStep++;
                StateHasChanged();
                await Task.Delay(2400);
            }
        }
        catch (ObjectDisposedException)
        {
            // страница закрыта во время проигрывания
        }
        finally
        {
            _autoPlaying = false;
        }
    }

    public void Dispose() => _autoPlaying = false;
}
